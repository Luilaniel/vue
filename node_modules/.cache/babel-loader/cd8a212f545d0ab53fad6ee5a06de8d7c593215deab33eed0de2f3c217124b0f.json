{"ast":null,"code":"import { mapActions, mapGetters } from 'vuex';\nexport default {\n  name: 'HomePage',\n  data() {\n    return {\n      carNumber: '',\n      driverName: '',\n      weight: null,\n      message: ''\n    };\n  },\n  computed: {\n    ...mapGetters(['getWeatherToday']),\n    weatherToday() {\n      return this.getWeatherToday;\n    }\n  },\n  methods: {\n    ...mapActions(['addCar', 'fetchWeatherForecast']),\n    refreshWeather() {\n      this.fetchWeatherForecast();\n    },\n    saveDriver() {\n      if (!this.carNumber || !this.driverName || !this.weight) {\n        this.message = 'Будь ласка, заповніть всі поля';\n        return;\n      }\n      const driverData = {\n        carNumber: this.carNumber,\n        driverName: this.driverName,\n        weight: this.weight,\n        weather: this.weatherToday // додаємо погоду\n      };\n      this.addCar(driverData);\n      this.message = 'Дані успішно збережено!';\n    }\n  }\n};","map":{"version":3,"names":["mapActions","mapGetters","name","data","carNumber","driverName","weight","message","computed","weatherToday","getWeatherToday","methods","refreshWeather","fetchWeatherForecast","saveDriver","driverData","weather","addCar"],"sources":["src/pages/Home.vue"],"sourcesContent":["<template>\r\n  <b-container>\r\n    <h1>Реєстрація водія</h1>\r\n    <b-form @submit.prevent=\"saveDriver\">\r\n      <b-form-group label=\"Номер машини\">\r\n        <b-form-input v-model=\"carNumber\" required />\r\n      </b-form-group>\r\n      <b-form-group label=\"Ім'я водія\">\r\n        <b-form-input v-model=\"driverName\" required />\r\n      </b-form-group>\r\n      <b-form-group label=\"Вага машини\">\r\n        <b-form-input v-model.number=\"weight\" type=\"number\" required />\r\n      </b-form-group>\r\n\r\n      <b-button type=\"submit\" variant=\"primary\">Зберегти</b-button>\r\n    </b-form>\r\n\r\n    <b-button @click=\"refreshWeather\" class=\"mt-3\">Оновити погоду</b-button>\r\n\r\n    <div v-if=\"weatherToday\" class=\"mt-3\">\r\n      <h5>Погода сьогодні ({{ weatherToday.date }}):</h5>\r\n      <p>Макс: {{ weatherToday.tempMax }} °C, Мін: {{ weatherToday.tempMin }} °C</p>\r\n      <p>Код погоди: {{ weatherToday.weathercode }}</p>\r\n    </div>\r\n\r\n    <div v-if=\"message\" class=\"mt-2 text-success\">{{ message }}</div>\r\n  </b-container>\r\n</template>\r\n\r\n<script>\r\nimport { mapActions, mapGetters } from 'vuex';\r\n\r\nexport default {\r\n  name: 'HomePage',\r\n  data() {\r\n    return {\r\n      carNumber: '',\r\n      driverName: '',\r\n      weight: null,\r\n      message: '',\r\n    };\r\n  },\r\n  computed: {\r\n    ...mapGetters(['getWeatherToday']),\r\n    weatherToday() {\r\n      return this.getWeatherToday;\r\n    },\r\n  },\r\n  methods: {\r\n    ...mapActions(['addCar', 'fetchWeatherForecast']),\r\n    refreshWeather() {\r\n      this.fetchWeatherForecast();\r\n    },\r\n    saveDriver() {\r\n      if (!this.carNumber || !this.driverName || !this.weight) {\r\n        this.message = 'Будь ласка, заповніть всі поля';\r\n        return;\r\n      }\r\n      const driverData = {\r\n        carNumber: this.carNumber,\r\n        driverName: this.driverName,\r\n        weight: this.weight,\r\n        weather: this.weatherToday, // додаємо погоду\r\n      };\r\n\r\n      this.addCar(driverData);\r\n      this.message = 'Дані успішно збережено!';\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AA8BA,SAAAA,UAAA,EAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,UAAA;MACAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,GAAAP,UAAA;IACAQ,aAAA;MACA,YAAAC,eAAA;IACA;EACA;EACAC,OAAA;IACA,GAAAX,UAAA;IACAY,eAAA;MACA,KAAAC,oBAAA;IACA;IACAC,WAAA;MACA,UAAAV,SAAA,UAAAC,UAAA,UAAAC,MAAA;QACA,KAAAC,OAAA;QACA;MACA;MACA,MAAAQ,UAAA;QACAX,SAAA,OAAAA,SAAA;QACAC,UAAA,OAAAA,UAAA;QACAC,MAAA,OAAAA,MAAA;QACAU,OAAA,OAAAP,YAAA;MACA;MAEA,KAAAQ,MAAA,CAAAF,UAAA;MACA,KAAAR,OAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}