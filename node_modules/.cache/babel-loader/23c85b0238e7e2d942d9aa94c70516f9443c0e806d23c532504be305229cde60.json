{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { mapGetters, mapActions } from 'vuex';\nexport default {\n  name: 'ContactPage',\n  computed: {\n    ...mapGetters(['getWeatherForecast']),\n    weatherRows() {\n      console.log('DEBUG weather data:', this.getWeatherForecast); // Обов'язково! Перевір у DevTools\n      if (!this.getWeatherForecast || !this.getWeatherForecast.time) return [];\n      const {\n        time,\n        temperature_2m_max,\n        temperature_2m_min,\n        weathercode\n      } = this.getWeatherForecast;\n      return time.map((date, index) => ({\n        date,\n        maxTemp: temperature_2m_max[index],\n        minTemp: temperature_2m_min[index],\n        weathercode: weathercode[index]\n      }));\n    }\n  },\n  methods: {\n    ...mapActions(['fetchWeatherForecast']),\n    updateWeather() {\n      this.fetchWeatherForecast();\n    },\n    getWeatherIcon(code) {\n      const icons = {\n        0: '☀️',\n        1: '🌤️',\n        2: '⛅',\n        3: '☁️',\n        45: '🌫️',\n        48: '🌫️',\n        51: '🌦️',\n        61: '🌧️',\n        71: '🌨️'\n      };\n      return icons[code] || '❓';\n    }\n  },\n  mounted() {\n    this.fetchWeatherForecast();\n  }\n};","map":{"version":3,"names":["mapGetters","mapActions","name","computed","weatherRows","console","log","getWeatherForecast","time","temperature_2m_max","temperature_2m_min","weathercode","map","date","index","maxTemp","minTemp","methods","updateWeather","fetchWeatherForecast","getWeatherIcon","code","icons","mounted"],"sources":["src/pages/Contact.vue"],"sourcesContent":["<template>\r\n  <b-container class=\"contact\">\r\n    <h1>Прогноз погоди для Вінниці</h1>\r\n    <b-button variant=\"primary\" @click=\"updateWeather\" class=\"mb-3\">Оновити прогноз</b-button>\r\n    <b-table striped hover :items=\"weatherRows\" :fields=\"['date', 'minTemp', 'maxTemp', 'weather']\">\r\n      <template #cell(weather)=\"data\">\r\n        <img :src=\"getWeatherIcon(data.item.weathercode)\" alt=\"icon\" width=\"30\" />\r\n      </template>\r\n    </b-table>\r\n  </b-container>\r\n</template>\r\n\r\n<script>\r\nimport { mapGetters, mapActions } from 'vuex';\r\nexport default {\r\n  name: 'ContactPage',\r\n  computed: {\r\n    ...mapGetters(['getWeatherForecast']),\r\n    weatherRows() {\r\n      console.log('DEBUG weather data:', this.getWeatherForecast); // Обов'язково! Перевір у DevTools\r\n      if (!this.getWeatherForecast || !this.getWeatherForecast.time) return [];\r\n\r\n      const { time, temperature_2m_max, temperature_2m_min, weathercode } = this.getWeatherForecast;\r\n\r\n      return time.map((date, index) => ({\r\n        date,\r\n        maxTemp: temperature_2m_max[index],\r\n        minTemp: temperature_2m_min[index],\r\n        weathercode: weathercode[index]\r\n      }));\r\n    }\r\n  },\r\n  methods: {\r\n    ...mapActions(['fetchWeatherForecast']),\r\n    updateWeather() {\r\n      this.fetchWeatherForecast();\r\n    },\r\n    getWeatherIcon(code) {\r\n      const icons = {\r\n        0: '☀️',\r\n        1: '🌤️',\r\n        2: '⛅',\r\n        3: '☁️',\r\n        45: '🌫️',\r\n        48: '🌫️',\r\n        51: '🌦️',\r\n        61: '🌧️',\r\n        71: '🌨️'\r\n      };\r\n      return icons[code] || '❓';\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchWeatherForecast();\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\nimg {\r\n  vertical-align: middle;\r\n}\r\n</style>"],"mappings":";;AAaA,SAAAA,UAAA,EAAAC,UAAA;AACA;EACAC,IAAA;EACAC,QAAA;IACA,GAAAH,UAAA;IACAI,YAAA;MACAC,OAAA,CAAAC,GAAA,6BAAAC,kBAAA;MACA,UAAAA,kBAAA,UAAAA,kBAAA,CAAAC,IAAA;MAEA;QAAAA,IAAA;QAAAC,kBAAA;QAAAC,kBAAA;QAAAC;MAAA,SAAAJ,kBAAA;MAEA,OAAAC,IAAA,CAAAI,GAAA,EAAAC,IAAA,EAAAC,KAAA;QACAD,IAAA;QACAE,OAAA,EAAAN,kBAAA,CAAAK,KAAA;QACAE,OAAA,EAAAN,kBAAA,CAAAI,KAAA;QACAH,WAAA,EAAAA,WAAA,CAAAG,KAAA;MACA;IACA;EACA;EACAG,OAAA;IACA,GAAAhB,UAAA;IACAiB,cAAA;MACA,KAAAC,oBAAA;IACA;IACAC,eAAAC,IAAA;MAC