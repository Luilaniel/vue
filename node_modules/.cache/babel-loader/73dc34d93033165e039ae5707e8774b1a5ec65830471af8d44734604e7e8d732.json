{"ast":null,"code":"import { mapActions, mapGetters } from 'vuex';\nexport default {\n  name: 'HomePage',\n  data() {\n    return {\n      carNumber: '',\n      driverName: '',\n      weight: null,\n      message: ''\n    };\n  },\n  computed: {\n    ...mapGetters(['getWeatherToday']),\n    weatherToday() {\n      return this.getWeatherToday;\n    }\n  },\n  methods: {\n    ...mapActions(['addCar', 'fetchWeatherForecast']),\n    refreshWeather() {\n      this.fetchWeatherForecast();\n    },\n    getWeatherIcon(code) {\n      const icons = {\n        0: '☀️',\n        1: '🌤️',\n        2: '⛅',\n        3: '☁️',\n        45: '🌫️',\n        48: '🌫️',\n        51: '🌦️',\n        61: '🌧️',\n        71: '🌨️',\n        95: '⛈️'\n      };\n      return icons[code] || '❓';\n    },\n    saveDriver() {\n      if (!this.carNumber || !this.driverName || !this.weight) {\n        this.message = 'Будь ласка, заповніть всі поля';\n        return;\n      }\n      const driverData = {\n        carNumber: this.carNumber,\n        driverName: this.driverName,\n        weight: this.weight,\n        weather: this.weatherToday\n      };\n      this.addCar(driverData);\n      this.message = 'Дані успішно збережено!';\n      this.carNumber = '';\n      this.driverName = '';\n      this.weight = null;\n    }\n  },\n  mounted() {\n    this.fetchWeatherForecast();\n  }\n};","map":{"version":3,"names":["mapActions","mapGetters","name","data","carNumber","driverName","weight","message","computed","weatherToday","getWeatherToday","methods","refreshWeather","fetchWeatherForecast","getWeatherIcon","code","icons","saveDriver","driverData","weather","addCar","mounted"],"sources":["src/pages/Home.vue"],"sourcesContent":["<template>\r\n  <b-container>\r\n    <h1>Реєстрація водія</h1>\r\n    <b-form @submit.prevent=\"saveDriver\">\r\n      <b-form-group label=\"Номер машини\">\r\n        <b-form-input v-model=\"carNumber\" required />\r\n      </b-form-group>\r\n      <b-form-group label=\"Ім'я водія\">\r\n        <b-form-input v-model=\"driverName\" required />\r\n      </b-form-group>\r\n      <b-form-group label=\"Вага машини\">\r\n        <b-form-input v-model.number=\"weight\" type=\"number\" required />\r\n      </b-form-group>\r\n\r\n      <b-button type=\"submit\" variant=\"primary\">Зберегти</b-button>\r\n    </b-form>\r\n\r\n    <b-button @click=\"refreshWeather\" class=\"mt-3\">Оновити погоду</b-button>\r\n\r\n    <div v-if=\"weatherToday\" class=\"mt-3\">\r\n      <h5>Погода сьогодні ({{ weatherToday.date }}):</h5>\r\n      <p>\r\n        Макс: {{ weatherToday.tempMax }} °C, Мін: {{ weatherToday.tempMin }} °C <br>\r\n        Погода: {{ getWeatherIcon(weatherToday.weathercode) }}\r\n      </p>\r\n    </div>\r\n\r\n    <div v-if=\"message\" class=\"mt-2 text-success\">{{ message }}</div>\r\n  </b-container>\r\n</template>\r\n\r\n<script>\r\nimport { mapActions, mapGetters } from 'vuex';\r\n\r\nexport default {\r\n  name: 'HomePage',\r\n  data() {\r\n    return {\r\n      carNumber: '',\r\n      driverName: '',\r\n      weight: null,\r\n      message: '',\r\n    };\r\n  },\r\n  computed: {\r\n    ...mapGetters(['getWeatherToday']),\r\n    weatherToday() {\r\n      return this.getWeatherToday;\r\n    },\r\n  },\r\n  methods: {\r\n    ...mapActions(['addCar', 'fetchWeatherForecast']),\r\n    refreshWeather() {\r\n      this.fetchWeatherForecast();\r\n    },\r\n    getWeatherIcon(code) {\r\n      const icons = {\r\n        0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️', 45: '🌫️',\r\n        48: '🌫️', 51: '🌦️', 61: '🌧️', 71: '🌨️', 95: '⛈️'\r\n      };\r\n      return icons[code] || '❓';\r\n    },\r\n    saveDriver() {\r\n      if (!this.carNumber || !this.driverName || !this.weight) {\r\n        this.message = 'Будь ласка, заповніть всі поля';\r\n        return;\r\n      }\r\n      const driverData = {\r\n        carNumber: this.carNumber,\r\n        driverName: this.driverName,\r\n        weight: this.weight,\r\n        weather: this.weatherToday,\r\n      };\r\n      this.addCar(driverData);\r\n      this.message = 'Дані успішно збережено!';\r\n      this.carNumber = '';\r\n      this.driverName = '';\r\n      this.weight = null;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.fetchWeatherForecast();\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAgCA,SAAAA,UAAA,EAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,UAAA;MACAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,GAAAP,UAAA;IACAQ,aAAA;MACA,YAAAC,eAAA;IACA;EACA;EACAC,OAAA;IACA,GAAAX,UAAA;IACAY,eAAA;MACA,KAAAC,oBAAA;IACA;IACAC,eAAAC,IAAA;MACA,MAAAC,KAAA;QACA;QAAA;QAAA;QAAA;QAAA;QACA;QAAA;QAAA;QAAA;QAAA;MACA;MACA,OAAAA,KAAA,CAAAD,IAAA;IACA;IACAE,WAAA;MACA,UAAAb,SAAA,UAAAC,UAAA,UAAAC,MAAA;QACA,KAAAC,OAAA;QACA;MACA;MACA,MAAAW,UAAA;QACAd,SAAA,OAAAA,SAAA;QACAC,UAAA,OAAAA,UAAA;QACAC,MAAA,OAAAA,MAAA;QACAa,OAAA,OAAAV;MACA;MACA,KAAAW,MAAA,CAAAF,UAAA;MACA,KAAAX,OAAA;MACA,KAAAH,SAAA;MACA,KAAAC,UAAA;MACA,KAAAC,MAAA;IACA;EACA;EACAe,QAAA;IACA,KAAAR,oBAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}