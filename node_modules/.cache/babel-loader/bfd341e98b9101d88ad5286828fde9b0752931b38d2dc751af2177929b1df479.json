{"ast":null,"code":"import CarModal from \"@/components/CarModal.vue\";\nexport default {\n  name: 'App',\n  components: {\n    CarModal\n  },\n  data() {\n    return {\n      form: {\n        number: '',\n        driver: '',\n        weight: null\n      },\n      savedData: null,\n      modalId: 'car-modal',\n      alert: {\n        message: '',\n        variant: 'success'\n      }\n    };\n  },\n  methods: {\n    openModal() {\n      this.$bvModal.show(this.modalId);\n    },\n    handleConfirm() {\n      this.savedData = {\n        ...this.form\n      };\n      this.form = {\n        number: '',\n        driver: '',\n        weight: null\n      };\n      this.alert.message = 'Дані збережені';\n      this.alert.variant = 'success';\n    }\n  },\n  handleCancel() {\n    this.alert.message = 'Дані не прийняті';\n    this.alert.variant = 'danger';\n  },\n  resetAlert() {\n    this.alert.message = '';\n    this.alert.variant = 'success';\n  }\n};","map":{"version":3,"names":["CarModal","name","components","data","form","number","driver","weight","savedData","modalId","alert","message","variant","methods","openModal","$bvModal","show","handleConfirm","handleCancel","resetAlert"],"sources":["src/App.vue"],"sourcesContent":["<template>\r\n  <div id=\"app\">\r\n      <div class=\"container mt-4\">\r\n        <b-form @submit.prevent=\"openModal\">\r\n          <b-form-group label=\"Номер машини\">\r\n            <b-form-input v-model=\"form.number\" required></b-form-input>\r\n          </b-form-group>\r\n          <b-form-group label=\"Ім'я водія\">\r\n            <b-form-input v-model=\"form.driver\" required></b-form-input>\r\n          </b-form-group>\r\n          <b-form-group label=\"Вага машини\">\r\n            <b-form-input type=\"number\" v-model=\"form.weight\" required></b-form-input>\r\n          </b-form-group>\r\n          <b-button type=\"submit\" variant=\"primary\">Зберегти</b-button>\r\n        </b-form>\r\n      </div>\r\n    <b-alert v-if=\"alert.message\" :variant=\"alert.variant\" dismissible class=\"mt-3\" @dismissed=\"resetAlert\">\r\n      {{ alert.message }}\r\n    </b-alert>\r\n    <CarModal :carData=\"form\" :modalId=\"modalId\" @confirm=\"handleConfirm\" @cancel=\"handleCancel\" />\r\n    <b-card v-if=\"savedData\" class=\"mt-3\">\r\n      <h5>Інформація про водія</h5>\r\n      <p>Номер: {{ savedData.number }}</p>\r\n      <p>Ім'я: {{ savedData.driver }}</p>\r\n      <p>Вага: {{ savedData.weight }}</p>\r\n    </b-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport CarModal from \"@/components/CarModal.vue\";\r\nexport default {\r\n  name: 'App',\r\n  components: {\r\n    CarModal,\r\n  },\r\n  data() {\r\n    return {\r\n      form: {\r\n        number: '',\r\n        driver: '',\r\n        weight: null\r\n      },\r\n      savedData: null,\r\n      modalId: 'car-modal',\r\n      alert: {\r\n        message: '',\r\n        variant: 'success',\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    openModal() {\r\n      this.$bvModal.show(this.modalId)\r\n    },\r\n    handleConfirm() {\r\n      this.savedData = { ...this.form };\r\n      this.form = { number: '', driver: '', weight: null };\r\n      this.alert.message = 'Дані збережені';\r\n      this.alert.variant = 'success';\r\n      }\r\n    },\r\n    handleCancel() {\r\n      this.alert.message = 'Дані не прийняті';\r\n      this.alert.variant = 'danger';\r\n    },\r\n    resetAlert() {\r\n      this.alert.message = '';\r\n      this.alert.variant = 'success';\r\n    },\r\n }\r\n</script>\r\n\r\n<style>\r\n\r\n</style>\r\n"],"mappings":"AA8BA,OAAAA,QAAA;AACA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;EACAG,KAAA;IACA;MACAC,IAAA;QACAC,MAAA;QACAC,MAAA;QACAC,MAAA;MACA;MACAC,SAAA;MACAC,OAAA;MACAC,KAAA;QACAC,OAAA;QACAC,OAAA;MACA;IACA;EACA;EACAC,OAAA;IACAC,UAAA;MACA,KAAAC,QAAA,CAAAC,IAAA,MAAAP,OAAA;IACA;IACAQ,cAAA;MACA,KAAAT,SAAA;QAAA,QAAAJ;MAAA;MACA,KAAAA,IAAA;QAAAC,MAAA;QAAAC,MAAA;QAAAC,MAAA;MAAA;MACA,KAAAG,KAAA,CAAAC,OAAA;MACA,KAAAD,KAAA,CAAAE,OAAA;IACA;EACA;EA