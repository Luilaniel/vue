{"ast":null,"code":"export default {\n  name: \"SomeDirectives\",\n  data() {\n    return {\n      name: '',\n      items: ['Перший пункт', 'Другий пункт', 'Третій пункт'],\n      agreed: false,\n      terms: ['Ви погоджуєтесь на обробку персональних даних', 'Ви приймаєте умови використання', 'Ви підтверджуєте, що вам є 18 років або більше']\n    };\n  },\n  methods: {\n    greeting() {\n      alert(\"Вітаю\");\n    },\n    toggleAgreement() {\n      this.agreed = !this.agreed;\n    }\n  }\n};","map":{"version":3,"names":["name","data","items","agreed","terms","methods","greeting","alert","toggleAgreement"],"sources":["src/components/SomeDirectives.vue"],"sourcesContent":["<template>\r\n  <b-container>\r\n    <b-form-input v-model=\"name\" placeholder=\"Введіть ваше ім'я\" />\r\n    <b-alert variant=\"info\" v-if=\"name\">Вітаю, {{ name }}</b-alert>\r\n    <b-alert v-else>Вітаю</b-alert>\r\n    <ul>\r\n      <li v-for=\"(item, index) in items\" :key=\"index\">{{ item }}</li>\r\n    </ul>\r\n    <button @click=\"greeting\">Натисніть мене!</button>\r\n    <br>\r\n    <label>\r\n      <input type=\"checkbox\" v-model=\"agreed\" />\r\n      Погоджуюся з умовами\r\n    </label>\r\n\r\n    <ul>\r\n      <li v-for=\"(term, index) in terms\" :key=\"'term-' + index\">{{ term }}</li>\r\n    </ul>\r\n    <button @click=\"toggleAgreement\">Змінити стан згоди</button>\r\n    <p v-if=\"agreed\">Дякуємо за згоду!</p>\r\n    <p v-else>Будь ласка, погодьтеся з умовами.</p>\r\n  </b-container>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"SomeDirectives\",\r\n  data() {\r\n    return {\r\n      name: '',\r\n      items: ['Перший пункт', 'Другий пункт', 'Третій пункт'],\r\n      agreed: false,\r\n      terms: [\r\n        'Ви погоджуєтесь на обробку персональних даних',\r\n        'Ви приймаєте умови використання',\r\n        'Ви підтверджуєте, що вам є 18 років або більше'\r\n      ]\r\n    }\r\n  },\r\n  methods: {\r\n    greeting() {\r\n      alert(\"Вітаю\");\r\n    },\r\n    toggleAgreement() {\r\n      this.agreed = !this.agreed;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\ndiv {\r\n  max-width: 400px;\r\n  margin: 20px;\r\n}\r\n\r\np {\r\n  margin: 8px 0;\r\n}\r\n\r\nbutton {\r\n  margin-bottom: 11px;\r\n}\r\n</style>"],"mappings":"AAyBA;EACAA,IAAA;EACAC,KAAA;IACA;MACAD,IAAA;MACAE,KAAA;MACAC,MAAA;MACAC,KAAA,GACA,iDACA,mCACA;IAEA;EACA;EACAC,OAAA;IACAC,SAAA;MACAC,KAAA;IACA;IACAC,gBAAA;MACA,KAAAL,MAAA,SAAAA,MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}