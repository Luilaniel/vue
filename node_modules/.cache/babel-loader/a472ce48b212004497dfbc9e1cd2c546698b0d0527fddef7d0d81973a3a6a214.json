rt default {\r\n  name: 'HomePage',\r\n  data() {\r\n    return {\r\n      carNumber: '',\r\n      driverName: '',\r\n      weight: null,\r\n      message: '',\r\n    };\r\n  },\r\n  methods: {\r\n    ...mapActions(['addCar']),\r\n    submitForm() {\r\n      this.addCar({\r\n        carNumber: this.carNumber,\r\n        driverName: this.driverName,\r\n        weight: this.weight\r\n      });\r\n      this.saved = true;\r\n      this.carNumber = '';\r\n      this.driverName = '';\r\n      this.weight = '';\r\n      setTimeout(() => (this.saved = false), 2000);\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AA8BA,SAAAA,UAAA,EAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,UAAA;MACAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACA,GAAAR,UAAA;IACAS,WAAA;MACA,KAAAC,MAAA;QACAN,SAAA,OAAAA,SAAA;QACAC,UAAA,OAAAA,UAAA;QACAC,MAAA,OAAAA;MACA;MACA,KAAAK,KAAA;MACA,KAAAP,SAAA;MACA,KAAAC,UAAA;MACA,KAAAC,MAAA;MACAM,UAAA,YAAAD,KAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}