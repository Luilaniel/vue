 savedData: null\r\n    };\r\n  },\r\n  methods: {\r\n    openModal() {\r\n      this.modalVisible = true;\r\n    },\r\n    handleConfirm(confirmed) {\r\n      this.modalVisible = false;\r\n      if (confirmed) {\r\n        this.savedData = { ...this.form };\r\n        this.alert = {\r\n          show: true,\r\n          message: \"Дані збережені\",\r\n          variant: \"success\"\r\n        };\r\n        // Очистити форму\r\n        this.form.number = \"\";\r\n        this.form.driver = \"\";\r\n        this.form.weight = \"\";\r\n      } else {\r\n        this.alert = {\r\n          show: true,\r\n          message: \"Дані не прийняті\",\r\n          variant: \"danger\"\r\n        };\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style>\r\n\r\n</style>\r\n"],"mappings":"AAmEA,OAAAA,YAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;EACAG,KAAA;IACA;MACAC,IAAA;QACAC,MAAA;QACAC,MAAA;QACAC,MAAA;MACA;MACAC,YAAA;MACAC,KAAA;QACAC,IAAA;QACAC,OAAA;QACAC,OAAA;MACA;MACAC,SAAA;IACA;EACA;EACAC,OAAA;IACAC,UAAA;MACA,KAAAP,YAAA;IACA;IACAQ,cAAAC,SAAA;MACA,KAAAT,YAAA;MACA,IAAAS,SAAA;QACA,KAAAJ,SAAA;UAAA,QAAAT;QAAA;QACA,KAAAK,KAAA;UACAC,IAAA;UACAC,OAAA;UACAC,OAAA;QACA;QACA;QACA,KAAAR,IAAA,CAAAC,MAAA;QACA,KAAAD,IAAA,CAAAE,MAAA;QACA,KAAAF,IAAA,CAAAG,MAAA;MACA;QACA,KAAAE,KAAA;UACAC,IAAA;UACAC,OAAA;UACAC,OAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}