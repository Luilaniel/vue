{"ast":null,"code":"import { mapGetters, mapActions } from 'vuex';\nexport default {\n  name: 'AboutPage',\n  computed: {\n    ...mapGetters('cars', ['getCars']),\n    cars() {\n      return this.getCars;\n    }\n  },\n  methods: {\n    ...mapActions('cars', ['deleteCar']),\n    deleteCarById(id) {\n      this.deleteCar(id);\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","mapActions","name","computed","cars","getCars","methods","deleteCarById","id","deleteCar"],"sources":["src/pages/About.vue"],"sourcesContent":["<template>\r\n  <b-container>\r\n    <h2>Список машин</h2>\r\n    <b-row>\r\n      <b-col cols=\"12\" md=\"6\" v-for=\"(car, index) in cars\" :key=\"index\" class=\"mb-3\">\r\n        <b-card>\r\n          <h5>Номер: {{ car.carNumber }}</h5>\r\n          <p>Водій: {{ car.driverName }}</p>\r\n          <p>Вага: {{ car.weight }} кг</p>\r\n          <b-button variant=\"danger\" @click=\"deleteCarById(car.id)\">Видалити</b-button>\r\n        </b-card>\r\n      </b-col>\r\n    </b-row>\r\n  </b-container>\r\n</template>\r\n\r\n<script>\r\nimport { mapGetters, mapActions } from 'vuex';\r\n\r\nexport default {\r\n  name: 'AboutPage',\r\n  computed: {\r\n    ...mapGetters('cars', ['getCars']),\r\n    cars() {\r\n      return this.getCars;\r\n    }\r\n  },\r\n  methods: {\r\n    ...mapActions('cars', ['deleteCar']),\r\n    deleteCarById(id) {\r\n      this.deleteCar(id);\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AAiBA,SAAAA,UAAA,EAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,QAAA;IACA,GAAAH,UAAA;IACAI,KAAA;MACA,YAAAC,OAAA;IACA;EACA;EACAC,OAAA;IACA,GAAAL,UAAA;IACAM,cAAAC,EAAA;MACA,KAAAC,SAAA,CAAAD,EAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}