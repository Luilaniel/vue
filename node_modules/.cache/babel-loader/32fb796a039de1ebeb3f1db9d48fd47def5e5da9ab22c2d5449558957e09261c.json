{"ast":null,"code":"export default {\n  name: 'App',\n  components: {}\n};","map":{"version":3,"names":["name","components"],"sources":["src/App.vue"],"sourcesContent":["<template>\r\n  <div id=\"app\">\r\n    <div class=\"container mt-4\">\r\n      <b-form @submit.prevent=\"openModal\">\r\n        <b-form-group label=\"Номер машини\" label-for=\"car-number\">\r\n          <b-form-input\r\n              id=\"car-number\"\r\n              v-model=\"form.number\"\r\n              required\r\n          ></b-form-input>\r\n        </b-form-group>\r\n\r\n        <b-form-group label=\"Ім’я водія\" label-for=\"driver-name\">\r\n          <b-form-input\r\n              id=\"driver-name\"\r\n              v-model=\"form.driver\"\r\n              required\r\n          ></b-form-input>\r\n        </b-form-group>\r\n\r\n        <b-form-group label=\"Вага машини\" label-for=\"car-weight\">\r\n          <b-form-input\r\n              id=\"car-weight\"\r\n              v-model=\"form.weight\"\r\n              type=\"number\"\r\n              required\r\n              min=\"0\"\r\n          ></b-form-input>\r\n        </b-form-group>\r\n\r\n        <b-button type=\"submit\" variant=\"primary\">Зберегти</b-button>\r\n      </b-form>\r\n\r\n      <!-- Модальне вікно -->\r\n      <modal-confirm\r\n          :visible=\"modalVisible\"\r\n          :number=\"form.number\"\r\n          :driver=\"form.driver\"\r\n          :weight=\"form.weight\"\r\n          @confirm=\"handleConfirm\"\r\n      ></modal-confirm>\r\n\r\n      <!-- Повідомлення -->\r\n      <b-alert\r\n          v-if=\"alert.show\"\r\n          :variant=\"alert.variant\"\r\n          dismissible\r\n          @dismissed=\"alert.show = false\"\r\n          class=\"mt-3\"\r\n      >\r\n        {{ alert.message }}\r\n      </b-alert>\r\n\r\n      <!-- Карта з інформацією про водія -->\r\n      <div v-if=\"savedData\" class=\"card mt-4\">\r\n        <div class=\"card-body\">\r\n          <h5 class=\"card-title\">Інформація про водія</h5>\r\n          <p class=\"card-text\"><strong>Номер машини:</strong> {{ savedData.number }}</p>\r\n          <p class=\"card-text\"><strong>Ім’я водія:</strong> {{ savedData.driver }}</p>\r\n          <p class=\"card-text\"><strong>Вага машини:</strong> {{ savedData.weight }}</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\n\r\nexport default {\r\n  name: 'App',\r\n  components: {\r\n\r\n  }\r\n}\r\n</script>\r\n\r\n<style>\r\n\r\n</style>\r\n"],"mappings":"AAqEA;EACAA,IAAA;EACAC,UAAA,GAEA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}