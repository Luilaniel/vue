{"ast":null,"code":"export default {\n  name: 'ModalConfirm',\n  props: {\n    visible: Boolean,\n    number: String,\n    driver: String,\n    weight: [String, Number]\n  },\n  methods: {\n    emitOk() {\n      this.$emit('confirm', true);\n    },\n    emitCancel() {\n      this.$emit('confirm', false);\n    }\n  }\n};","map":{"version":3,"names":["name","props","visible","Boolean","number","String","driver","weight","Number","methods","emitOk","$emit","emitCancel"],"sources":["src/components/ModalConfirm.vue"],"sourcesContent":["<template>\r\n  <b-modal\r\n      :visible=\"visible\"\r\n      title=\"Підтвердження\"\r\n      hide-footer\r\n      no-close-on-esc\r\n      no-close-on-backdrop\r\n      @hide=\"emitCancel\"\r\n  >\r\n    <p>Прийняти зміни для машини <strong>{{ number }}</strong> з водієм <strong>{{ driver }}</strong> та вагою <strong>{{ weight }}</strong>?</p>\r\n\r\n    <template #modal-footer>\r\n      <b-button variant=\"secondary\" @click=\"emitCancel\">Cancel</b-button>\r\n      <b-button variant=\"primary\" @click=\"emitOk\">OK</b-button>\r\n    </template>\r\n  </b-modal>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ModalConfirm',\r\n  props: {\r\n    visible: Boolean,\r\n    number: String,\r\n    driver: String,\r\n    weight: [String, Number]\r\n  },\r\n  methods: {\r\n    emitOk() {\r\n      this.$emit('confirm', true);\r\n    },\r\n    emitCancel() {\r\n      this.$emit('confirm', false);\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAmBA;EACAA,IAAA;EACAC,KAAA;IACAC,OAAA,EAAAC,OAAA;IACAC,MAAA,EAAAC,MAAA;IACAC,MAAA,EAAAD,MAAA;IACAE,MAAA,GAAAF,MAAA,EAAAG,MAAA;EACA;EACAC,OAAA;IACAC,OAAA;MACA,KAAAC,KAAA;IACA;IACAC,WAAA;MACA,KAAAD,KAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}